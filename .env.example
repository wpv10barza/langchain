# LLM provider
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini
# Optional for OpenAI-compatible providers:
# OPENAI_BASE_URL=https://example.com/v1

# LangSmith observability (current variable names)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace_me
LANGSMITH_PROJECT=langchain-master
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Legacy compatibility accepted by app.py if LANGSMITH_* is absent:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=replace_me
# LANGCHAIN_PROJECT=langchain-master
